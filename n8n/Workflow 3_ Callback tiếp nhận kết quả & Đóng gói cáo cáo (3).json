    {
      "parameters": {
        "jsCode": "const payload = $input.item.json.body;\nconst rawDetections = payload.detections || {};\nconst teamsMsgId = payload.teams_message_id;\nconst videoKey = payload.raw_video_key;\n\n// 1. Phân giải URL Ảnh công khai\nlet rawImageUrl = \"N/A - Video Mode\";\nif (payload.media_type === \"image\" || (videoKey && videoKey.includes(\"raw-image\"))) {\n    rawImageUrl = \"https://pub-6c0dc0b0cf86456085c1ddfb12e9f2ea.r2.dev/\" + videoKey;\n}\n\n// 2. KHẮC PHỤC LỖI RỖNG: AI không tìm thấy vật thể\nif (Object.keys(rawDetections).length === 0) {\n    return [{\n        json: {\n            video_key: videoKey,\n            raw_image_url: rawImageUrl,\n            object_class: \"NO_OBJECT_DETECTED\",\n            sku_code: \"NONE\",\n            quantity: 0,\n            confidence_array: \"[]\",\n            final_confidence: 0,\n            teams_message_id: teamsMsgId,\n            scan_time: new Date().toISOString()\n        }\n    }];\n}\n\n// 3. Đọc dữ liệu (Lấy trực tiếp kết quả đếm từ Python, KHÔNG tự đếm lại)\nconst outputRows = [];\nfor (const [sku, data] of Object.entries(rawDetections)) {\n    outputRows.push({\n        json: {\n            video_key: videoKey,\n            raw_image_url: rawImageUrl,\n            object_class: sku,\n            sku_code: sku,\n            quantity: data.count, // <--- ĐIỂM QUAN TRỌNG NHẤT: Lấy trực tiếp số lượng Tracking\n            confidence_array: JSON.stringify([data.min_confidence, data.max_confidence]), // Lưu khoảng tin cậy Min-Max\n            final_confidence: data.avg_confidence, \n            teams_message_id: teamsMsgId,\n            scan_time: new Date().toISOString()\n        }\n    });\n}\n\nreturn outputRows;"
      },
