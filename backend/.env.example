# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=inventory-ai-inspection-mvp
R2_PUBLIC_BASE_URL=

# KiotViet
KIOTVIET_RETAILER=your-retailer
KIOTVIET_CLIENT_ID=your-client-id
KIOTVIET_CLIENT_SECRET=your-client-secret
KIOTVIET_BRANCH_NAME=Warehouse
KIOTVIET_PURCHASE_BY_USERNAME=
KIOTVIET_SUPPLIER_CODE=
KIOTVIET_CREATE_AS_DRAFT=false
KIOTVIET_MERGE_DAILY_DRAFTS=true
KIOTVIET_REPLACE_COMPLETED_ON_UPDATE_FAILURE=true
KIOTVIET_AUTO_CREATE_DRAFT=false
KIOTVIET_DEFAULT_PURCHASE_PRICE=0

# Local KiotViet manufacturing RPA (required only for "Phiếu sản xuất")
MANUFACTURING_RPA_BASE_URL=http://127.0.0.1:8000
MANUFACTURING_RPA_INTERNAL_TOKEN=replace-with-a-long-random-token
MANUFACTURING_RPA_TIMEOUT_SECONDS=180

# Bakery AI model
YOLO_MODEL_PATH=models/best_YOLO26s_26SKUs_2656_31SKUs.pt
BAKERY_CONFIDENCE=0.25
BAKERY_IOU=0.50
BAKERY_IMAGE_SIZE=1024
BAKERY_MAX_DETECTIONS=300
BAKERY_CROSS_CLASS_DUPLICATE_COVERAGE=0.85
BAKERY_CONFLICT_REVIEW_MIN_DOMINANT_COUNT=2
# Conservative correction for one weaker, conflicting box clipped by an edge.
# The normal 0.90 dominant-purity safety gate remains unchanged.
BAKERY_EDGE_CLASS_OUTLIER_ENABLED=true
BAKERY_EDGE_CLASS_OUTLIER_MARGIN_RATIO=0.01
BAKERY_EDGE_CLASS_OUTLIER_CONFIDENCE_GAP=0.10
BAKERY_EDGE_CLASS_OUTLIER_MIN_DOMINANT_COUNT=2

# Hybrid detector (YOLO fast path + SAM2/DINOv2 fallback)
HYBRID_ENABLED=true
HYBRID_DEFAULT_MODE=AUTO
HYBRID_YOLO_FALLBACK_MARGIN=0.04
# AUTO box rescue: one prompted SAM2 pass + batched DINOv2 verification.
HYBRID_BOX_RESCUE_ENABLED=true
HYBRID_BOX_RESCUE_MIN_THRESHOLD_RATIO=0.50
HYBRID_BOX_RESCUE_MIN_CONFIDENCE=0.05
HYBRID_BOX_RESCUE_MAX_CANDIDATES=30
HYBRID_BOX_RESCUE_EXPANSION_RATIO=0.12
HYBRID_BOX_RESCUE_EXISTING_COVERAGE=0.60
FOUNDATION_SAM_MODEL_PATH=models/sam2.1_s.pt
FOUNDATION_DINO_MODEL=facebook/dinov2-small
FOUNDATION_REFERENCE_PATH=hybrid_data/reference_embeddings.npz
FOUNDATION_REGISTRY_PATH=config/hybrid_reference_registry.json
FOUNDATION_POINTS_STRIDE=96
FOUNDATION_SAM_MAX_SIDE=1280
FOUNDATION_MIN_MASK_AREA_RATIO=0.0015
FOUNDATION_MAX_MASK_AREA_RATIO=0.35
FOUNDATION_MAX_BOX_AREA_RATIO=0.22
FOUNDATION_EDGE_MARGIN_RATIO=0.005
FOUNDATION_MASK_NMS_IOU=0.72
FOUNDATION_MASK_QUALITY=0.55
FOUNDATION_SIMILARITY_THRESHOLD=0.72
FOUNDATION_SIMILARITY_MARGIN=0.04
FOUNDATION_INSTANCE_SIMILARITY_THRESHOLD=0.60
FOUNDATION_INSTANCE_SIMILARITY_MARGIN=0.02
FOUNDATION_INSTANCE_MIN_AREA_FACTOR=0.35
FOUNDATION_INSTANCE_MAX_AREA_FACTOR=2.50
FOUNDATION_INSTANCE_BOX_COVERAGE_NMS=0.45
PSEUDO_LABEL_ENABLED=true
PSEUDO_LABEL_ROOT=runtime/hybrid_dataset

# Upload limits
MAX_IMAGES_PER_JOB=50
MAX_IMAGE_SIZE_BYTES=52428800
MAX_JOB_UPLOAD_SIZE_BYTES=209715200
# Keep at 1 on the current Windows workstation to avoid native OpenSSL crashes.
R2_TRANSFER_WORKERS=1
BAKERY_INFERENCE_BATCH_SIZE=4

# Application and n8n Basic Auth (use the same values in n8n credentials)
APP_AUTH_USERNAME=ai-sharon
APP_AUTH_PASSWORD=change-this-password
# Optional separate key for the hidden developer panel. If omitted, the web
# application password is used for backward compatibility.
DEVELOPER_SETTINGS_KEY=
N8N_WEBHOOK_BASE=https://n8n.example.com/webhook
N8N_WEBHOOK_USERNAME=ai-sharon
N8N_WEBHOOK_PASSWORD=change-this-password
N8N_REQUEST_TIMEOUT_SECONDS=30
