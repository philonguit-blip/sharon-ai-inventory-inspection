# =========================================================
# SHARON BAKERY AI PRODUCTS INSPECTION SYSTEM
# .gitignore
# =========================================================

# =========================================================
# 1. SECRETS / LOCAL CONFIGURATION
# =========================================================
.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

*.pem
*.key
*.p12
*.pfx
*.crt

.dev.vars
*.secret
*.secrets

# =========================================================
# 2. PYTHON ENVIRONMENTS / CACHE
# =========================================================
.venv/
**/.venv/
**/.venv-*/

venv/
**/venv/

env/
**/env/

__pycache__/
**/__pycache__/

*.py[cod]
*.pyo
*.pyd

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

build/
dist/
*.egg-info/

# =========================================================
# 3. NODE / NPM / CLOUDFLARE LOCAL STATE
# =========================================================
node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.wrangler/
**/.wrangler/

cloudflared/

# =========================================================
# 4. RUNTIME / TEMPORARY APPLICATION DATA
# =========================================================
runtime/
backend/runtime/
**/runtime/

.runtime/
**/.runtime/

tmp/
**/tmp/

temp/
**/temp/

*.tmp
*.temp

logs/
**/logs/
*.log

# =========================================================
# 5. UPLOADS / GENERATED OUTPUTS
# =========================================================
uploads/
**/uploads/

downloads/
**/downloads/

outputs/
**/outputs/

output/
**/output/

reports/
**/reports/

report/
**/report/

runs/
**/runs/

results/
**/results/

# =========================================================
# 6. TRAINING DATASETS / IMAGES / LABELS
# =========================================================
datasets/
**/datasets/

dataset/
**/dataset/

data/
**/data/

images/
**/images/

labels/
**/labels/

*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tif
*.tiff

!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.png
!docs/**/*.webp

# =========================================================
# 7. AI MODELS / LARGE ARTIFACTS
# =========================================================
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite

*.npz
reference_embeddings.npz

backend/hybrid_data/*
!backend/hybrid_data/README.md

backend/foundation_data/
**/foundation_data/

# =========================================================
# 8. ARCHIVES / LARGE MEDIA
# =========================================================
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

*.mp4
*.avi
*.mov
*.mkv

# =========================================================
# 9. SPREADSHEETS / GENERATED REPORT FILES
# =========================================================
*.xlsx
*.xls
*.csv

# =========================================================
# 10. DATABASE / LOCAL STATE
# =========================================================
*.db
*.sqlite
*.sqlite3

job_state/
queue_state/
state/

# =========================================================
# 11. LOCAL RESEARCH / EXPERIMENT FOLDERS
# =========================================================
/pre-annotation/
/sharon-cv-pipeline/
/_archive/
/scratch/
/experiments-local/

# =========================================================
# 12. IDE / OS FILES
# =========================================================
.vscode/
.idea/

.DS_Store
Thumbs.db
Desktop.ini

*.swp
*.swo
*~

# =========================================================
# 13. JUPYTER / COLAB
# =========================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# =========================================================
# 14. LOCAL MODEL DIRECTORIES
# =========================================================
models/*
!models/README.md

backend/models/*
!backend/models/README.md

# Ultralytics local settings/cache
.ultralytics/
**/.ultralytics/

# =========================================================
# 15. IMPORTANT CONFIG / SOURCE FILES
# =========================================================
#
# These files are intentionally NOT ignored and can be
# versioned normally:
#
# - product_mapping.json
# - hybrid_reference_registry.json
# - developer_settings.json
# - n8n workflow JSON files
# - Python source code
# - frontend source code
# - README.md
# - requirements.txt
#
# Never commit passwords, API keys, client secrets or tokens.
# =========================================================
